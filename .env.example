# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel (produção).

# Endereço público do site, sem barra no fim. Sem ela, a Vercel usa o domínio de produção do projeto.
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Contatos exibidos em /termos, /privacidade e no espaço "Anuncie aqui" (opcionais).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ADVERTISE_CONTACT=

# Supabase (projeto "CS GO", organização igormtk). URL e chave publicável podem ir para o navegador: as tabelas só
# permitem leitura pública (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://tjcfnqjxnhmqrxnqowuf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Syug7J7CRK-QlPyJ-lMINw_-inNmgT_

# Só para scripts e GitHub Actions (scripts/sync-player-teams.mjs). NUNCA use no navegador nem na Vercel.
# Pegue a chave secreta em Supabase → Project Settings → API Keys.
SUPABASE_URL=https://tjcfnqjxnhmqrxnqowuf.supabase.co
SUPABASE_SECRET_KEY=

# Contato no User-Agent das chamadas ao Liquipedia (exigido pelos termos da API).
LIQUIPEDIA_CONTACT=
